<!-- Оборачиваем всю карточку в Turbo Frame. Теперь любые действия внутри этого блока -->
<!-- (клики, отправка форм) будут обновлять ТОЛЬКО этот маленький кусочек экрана! -->
<%= turbo_frame_tag "sprout_card_#{@sprout.id}" do %>
  <div class="sprout-card <%= badge_class %>" style="border: 2px solid #ccc; padding: 15px; border-radius: 8px; margin-bottom: 15px;">
    
    <!-- Заголовок и информация о ростке -->
    <div class="sprout-header">
      <h3 style="margin-top: 0;">🌱 <%= @sprout.name %></h3>
      <span class="badge" style="font-weight: bold;"><%= @sprout.badge_type.upcase %></span>
    </div>

    <p class="sprout-description"><%= @sprout.description %></p>

    <!-- Вывод цены через наш внутренний метод компонента -->
    <div class="sprout-price" style="font-size: 1.2em; margin-bottom: 10px;">
      Цена: <strong><%= formatted_price %></strong>
    </div>

    <!-- Вшитая форма оплаты (интеграция нашего предыдущего рабочего кода) -->
    <div class="sprout-actions">
      <%= form_with(model: @purchase, local: true, html: { id: "payment-form-#{@sprout.id}" }) do |form| %>
        <%= form.hidden_field :sprout_id, value: @sprout.id %>
        
        <!-- Защита от двойных кликов -->
        <%= hidden_field_tag :idempotency_key, SecureRandom.uuid %>
        
        <!-- Наша идеальная рабочая кнопка (type="submit") со встроенными стилями -->
        <button type="submit" style="background: #28a745; color: white; border: none; padding: 8px 16px; font-size: 0.9em; border-radius: 4px; font-weight: bold; cursor: pointer;">
          Оплатить росток
        </button>
      <% end %>
    </div>

  </div>
<% end %>