<%= form_with(model: [ @user, @user.wall_comments.build ], local: false) do |f| %>
  <div style="margin-bottom: 10px;">
    <%= f.text_area :content, 
                    placeholder: "Что нового?", 
                    style: "width: 100%; height: 60px; border-radius: 6px; border: 1px solid #ddd; padding: 10px; resize: none;" %>
  </div>
  <%= f.submit "Отправить", 
               style: "background: #007bff; color: white; border: none; padding: 7px 15px; border-radius: 4px; cursor: pointer;" %>
<% end %>