<% # --- ИСПРАВЛЕНИЕ: Передаем в модель массив из [@user, comment], где comment — это переменная, пришедшая из профиля --- %>
<%= form_with(model: [ @user, comment ], 
              id: "wall-comment-form", 
              local: true) do |f| %>
              
  <div style="margin-bottom: 10px;">
    <% # --- ИСПРАВЛЕНИЕ: Поменяли :content на :body, так как это поле прописано в CommentsController и базе данных --- %>
    <%= f.text_area :body, 
                    placeholder: "Что нового?", 
                    style: "width: 100%; height: 60px; border-radius: 6px; border: 1px solid #ddd; padding: 10px; resize: none;" %>
  </div>

  <%= f.submit "Отправить", 
               style: "background: #007bff; color: white; border: none; padding: 7px 15px; border-radius: 4px; cursor: pointer;" %>
<% end %>