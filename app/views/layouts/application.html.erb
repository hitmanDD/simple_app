<head>
  <title>SocialNetwork</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  
  <% # Оставляем все стандартные мета-теги %>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <% # Стили — добавляем track: reload, чтобы Turbo следил за ними %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  
  <% # главный тег импорта JS — без него Turbo не живет %>
  <%= javascript_importmap_tags %>

  <% # --- То, чего не хватало для стабильности Turbo) --- %>
  <% # Этот тег заставляет Turbo корректно обрабатывать переходы и не "дергать" страницу %>
  <meta name="turbo-visit-control" content="reload">
  
  <% # Фавиконка: добавил проверку на наличие файла, чтобы Rails не выдавал ошибку AssetNotFound %>
  <% if Rails.application.assets.find_asset('favicon.ico') %>
    <%= favicon_link_tag 'favicon.ico' %>
  <% end %>
</head>

<body style="background-color: #f0f2f5; margin: 0; font-family: sans-serif;">
  <% # Оставляем yield, куда рендерится страница %>
  <%= yield %>
</body>