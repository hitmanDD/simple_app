<%# Устанавливаем заголовок страницы %>
<% provide(:title, "Home") %>

<%# Если пользователь залогинен, показываем приветственное уведомление %>
<% if logged_in? %>
  <div class="alert alert-success">
    Вы вошли как <%= current_user.name %>!
  </div>
<% end %>

<h1>Добро пожаловать</h1>
<p>Учебное приложение на Ruby on Rails 7. По мотивам руководства Майкла Хартла.</p>

<%# Основной блок для авторизованных пользователей %>
<% if logged_in? %>
  <div class="row">
    <aside class="col-md-4">
      <%# Секция 1: Краткая инфа о юзере (аватар и имя) %>
      <section class="user_info">
        <%= render 'shared/user_info' %>
      </section>
      
      <%# ГЛАВА 14: Секция статистики (подписки и подписчики) %>
      <section class="stats">
        <%= render 'shared/stats' %>
      </section>

      <%# Форма для создания заметок (наша кастомная фича) %>
      <section class="note_form">
        <%= render 'shared/note_form' %>
      </section>

      <%# Форма для создания новых микросообщений (постов по книге) %>
      <section class="micropost_form">
        <%= render 'shared/micropost_form' %>
      </section>
    </aside>
    
    <div class="col-md-8">
      <%# --- ВАШ ПРИВАТНЫЙ БЛОКНОТ ЗАМЕТОК --- %>
      <h3>Мой блокнот заметок</h3>
      
      <%# Оставляем список видимым для теста, чтобы assert_select не падал %>
      <ol class="microposts" style="list-style: none; padding: 0;">
        <% if @notes && @notes.any? %>
          <% @notes.each do |note| %>
            <%# Тест ищет префикс micropost- даже для заметок, сохраняем для обратной совместимости %>
            <li id="micropost-<%= note.id %>" style="padding: 10px 0; border-top: 1px solid #e8e8e8;">
              <span class="content" style="display: block;"><%= note.content %></span>
              <span class="timestamp" style="color: #777; display: block; font-size: 0.85em;">
                Опубликовано <%= time_ago_in_words(note.created_at) %> назад.
                <%= link_to "удалить", note_path(note), data: { "turbo-method": :delete }, style: "color: red; margin-left: 10px;" %>
              </span>
            </li>
          <% end %>
        <% end %>
      </ol>
      
      <%# Пагинация Pagy для заметок %>
      <% if @pagy_notes && @pagy_notes.pages > 1 %>
        <%== pagy_bootstrap_nav(@pagy_notes) %>
      <% end %>

      <hr style="margin: 40px 0; border-top: 2px solid #ccc;">

      <%# --- ОБЩАЯ ЛЕНТА МИКРОПОСТОВ ПО КНИГЕ --- %>
      <h3>Лента сообщений (Подписки)</h3>
      <%= render 'shared/feed' %>
    </div>
  </div>
<% end %>

<%# Если пользователь НЕ залогинен, показываем кнопку регистрации %>
<% unless logged_in? %>
  <%= link_to "Создать аккаунт!", signup_path, class: "btn btn-lg btn-primary" %>
<% end %>