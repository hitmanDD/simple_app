<%# 1. Проверяем, что зашедший пользователь не смотрит свой собственный профиль. %>
<%# Свою кнопку подписки/отписки видеть не нужно. %>
<% unless current_user?(@user) %>

  <%# 2. Критически важный блок с id="follow_form". %>
  <%# Именно этот ID ищет Turbo Stream в файле create.turbo_stream.erb, %>
  <%# чтобы вырезать старую кнопку и вставить новую без перезагрузки всей страницы! %>
  <div id="follow_form">
    
    <%# 3. Проверяем, подписан ли текущий пользователь на просматриваемого (@user). %>
    <% if current_user.following?(@user) %>
      <%# Если подписан — рендерим партиал с кнопкой Unfollow %>
      <%= render 'users/unfollow' %>
    <% else %>
      <%# Если не подписан — рендерим партиал с кнопкой Follow %>
      <%= render 'users/follow' %>
    <% end %>

  </div>
<% end %>