<div style="display: flex; gap: 20px; align-items: flex-start; max-width: 1200px; margin: 0 auto; padding: 20px;">
  
  <% # --- ЛЕВАЯ КОЛОНКА (Фиксированная) --- %>
  <div style="flex: 0 0 300px; position: sticky; top: 20px; background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
    <h2 style="margin-top: 0;"><%= @user.name %></h2>
    <p style="color: #666; font-size: 0.9em;">Email: <%= @user.email %></p>
    
    <div style="margin-top: 20px; border-top: 1px solid #eee; padding-top: 10px;">
      <% # --- ИСПРАВЛЕНИЕ: Интеграция динамического статуса сети из модели User --- %>
      <p>Статус: 
        <% if @user.online? %>
          <span style="color: #28a745; font-weight: bold;">В сети</span>
        <% else %>
          <span style="color: #777;">Оффлайн</span>
        <% end %>
      </p>
      
      <p style="font-size: 0.85em;">На сайте с:<br> <%= time_ago_in_words(@user.created_at) %> назад</p>
      
      <% # --- ИСПРАВЛЕНИЕ: Вывод реального времени последнего входа через метод модели --- %>
      <p style="font-size: 0.85em; color: #999;">Активность:<br> <%= @user.last_seen_info %></p>
    </div>

    <% # --- НАШ НОВЫЙ БЛОК: СИСТЕМА НАГРАД И АЧИВОК (Гармонично под блоком активности) --- %>
    <% if @user.badges.any? %>
      <div style="margin-top: 20px; border-top: 1px solid #eee; padding-top: 15px;">
        <h4 style="margin: 0 0 10px 0; font-size: 0.95em; color: #444; text-transform: uppercase; letter-spacing: 0.5px;">
          Награды (<%= @user.badges.count %>)
        </h4>
        <% # Сетка для иконок: выстраивает эмодзи в ряд с красивым фоном в тон левой панели %>
        <div style="display: flex; flex-wrap: wrap; gap: 10px; background: #fdfdfd; padding: 10px; border-radius: 6px; border: 1px solid #f0f0f0;">
          <% @user.badges.each do |badge| %>
            <% # Элемент награды: при наведении мыши показывает описание через стандартный тег title %>
            <div title="<%= badge.description %>" style="font-size: 26px; cursor: help; display: inline-block; line-height: 1; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
              <%= badge.icon %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
    <% # ----------------------------------------------------------------------------- %>

  </div>

  <% # --- ПРАВАЯ КОЛОНКА (Стена с прокруткой) --- %>
  <div style="flex: 1; background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); min-height: 100vh;">
    
    <h3 style="margin-top: 0;">Стена профиля (<%= @user.wall_comments.count %>)</h3>

    <% # Форма записи на стене %>
    <div style="margin-bottom: 20px;">
      <% # --- ИСПРАВЛЕНИЕ: Передаем правильную переменную @wall_comment, которую создали в контроллере --- %>
      <%= render 'comments/form', comment: @wall_comment %>
    </div>

    <% # Список комментариев %>
    <ul id="comments-list" style="list-style: none; padding: 0; margin: 0;">
      <% # Рендерим только сохраненные записи, чтобы избежать ошибки nil в created_at %>
      <% # --- ИСПРАВЛЕНИЕ: Используем пагинированную переменную @wall_comments вместо всех записей подряд --- %>
      <%= render @wall_comments.select(&:persisted?) %>
    </ul>

    <% # --- НОВЫЙ БЛОК: КНОПКИ ПАГИНАЦИИ ДЛЯ СТЕНЫ --- %>
    <% # Отображаем пагинацию Pagy только если записей больше, чем умещается на одной странице %>
    <% if @pagy_comments.pages > 1 %>
      <div style="margin-top: 20px; text-align: center;">
        <%== pagy_nav(@pagy_comments) %>
      </div>
    <% end %>
    <% # -------------------------------------------------- %>

  </div>
</div>