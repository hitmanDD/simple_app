<div style="display: flex; gap: 20px; align-items: flex-start; max-width: 1200px; margin: 0 auto; padding: 20px;">
  
  <% # --- ЛЕВАЯ КОЛОНКА (Фиксированная) --- %>
  <div style="flex: 0 0 300px; position: sticky; top: 20px; background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
    <h2 style="margin-top: 0;"><%= @user.name %></h2>
    <p style="color: #666; font-size: 0.9em;">Email: <%= @user.email %></p>
    
    <div style="margin-top: 20px; border-top: 1px solid #eee; padding-top: 10px;">
      <% # --- ИСПРАВЛЕНИЕ: Интеграция динамического статуса сети из модели User --- %>
      <p>Статус: 
        <% if @user.online? %>
          <span style="color: #28a745; font-weight: bold;">В сети</span>
        <% else %>
          <span style="color: #777;">Оффлайн</span>
        <% end %>
      </p>
      
      <p style="font-size: 0.85em;">На сайте с:<br> <%= time_ago_in_words(@user.created_at) %> назад</p>
      
      <% # --- ИСПРАВЛЕНИЕ: Вывод реального времени последнего входа через метод модели --- %>
      <p style="font-size: 0.85em; color: #999;">Active:<br> <%= @user.last_seen_info %></p>
    </div>

    <% # --- НОВЫЙ КОД: ПОДКЛЮЧЕНИЕ ТУРБО-СТРИМОВ ДЛЯ ОБНОВЛЕНИЯ АЧИВОК И УВЕДОМЛЕНИЙ --- %>
    <% if @user == current_user %>
      <%= turbo_stream_from "user_#{@user.id}_badges" %>
      <%= turbo_stream_from "user_#{@user.id}_notifications" %>
    <% end %>

     <% # --- НОВЫЙ КОД: ИНТЕРАКТИВНЫЙ МАГАЗИН ПЛАТНЫХ АЧИВОК --- %>
    <% if @user == current_user %>
      <div style="margin-top: 20px; border-top: 1px solid #eee; padding-top: 15px;">
        <h4 style="margin: 0 0 10px 0; font-size: 0.95em; color: #444; text-transform: uppercase; letter-spacing: 0.5px;">
          Магазин наград
        </h4>
        
        <div style="display: flex; flex-direction: column; gap: 10px;">
          <% 
            # Собираем типы уже купленных наград, чтобы скрыть их из магазина
            owned_types = @user.badges.map { |b| 
              if b.respond_to?(:badge_type) then b.badge_type 
              elsif b.respond_to?(:name) then b.name 
              else b.id.to_s end 
            }
            # Загружаем товары, которые пользователь еще может приобрести
            available_products = BadgeProduct.where(active: true).where.not(badge_type: owned_types) 
          %>
          
          <% if available_products.any? %>
            <% available_products.each do |product| %>
              <% 
                # Кастомные иконки для трех ачивок в зависимости от типа
                badge_icon = case product.badge_type
                             when 'sprout' then '🌱'
                             when 'gold_medal' then '🥇'
                             else '🏅'
                             end
              %>
              
              <% # Тег details позволяет скрывать контент и показывать его только при клике %>
              <details style="background: #f9f9f9; border: 1px solid #eee; border-radius: 6px; padding: 6px 10px; cursor: pointer; transition: background 0.2s;">
                
                <% # Заголовок, который виден всегда (иконка ачивки) %>
                <summary style="display: flex; align-items: center; justify-content: space-between; list-style: none; font-size: 24px; outline: none;">
                  <span><%= badge_icon %></span>
                  <span style="font-size: 0.55em; color: #007bff; font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px;">Разблокировать</span>
                </summary>

                <% # Выпадающий скрытый блок с ценником и ссылкой оплаты %>
                <% # УСТРАНЕНИЕ БАГА: выносим форму в чистый HTML-вид с явным отключением turbo через строку %>
                <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 10px; padding-top: 8px; border-top: 1px dashed #ddd; cursor: default;" onclick="event.stopPropagation();">
                  <div>
                    <div style="font-size: 0.85em; font-weight: bold; color: #333;"><%= product.badge_type.humanize %></div>
                    <div style="font-size: 0.8em; color: #28a745; font-weight: bold;"><%= product.price %> <%= product.currency %></div>
                  </div>

                  <form action="<%= orders_path %>" method="post" data-turbo="false" style="margin: 0;">
                    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                    <input type="hidden" name="badge_type" value="<%= product.badge_type %>">
                    <input type="hidden" name="currency" value="<%= product.currency %>">
                    <button type="submit" style="background: #28a745; color: white; border: none; padding: 6px 12px; font-size: 0.8em; border-radius: 4px; font-weight: bold; cursor: pointer;">
                      Оплатить
                    </button>
                  </form>
                </div>

              </details>
            <% end %>
          <% else %>
            <p style="color: #999; font-size: 0.85em; margin: 0;">Вы приобрели все доступные награды!</p>
          <% end %>
        </div>
      </div>
    <% end %>
    <% # ----------------------------------------------------------------------------- %>

  </div>

  <% # --- ПРАВАЯ КОЛОНКА (Стена с прокруткой) --- %>
  <div style="flex: 1; background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); min-height: 100vh;">
    
    <h3 style="margin-top: 0;">Стена профиля (<%= @user.wall_comments.count %>)</h3>

    <% # Форма записи на стене %>
    <div style="margin-bottom: 20px;">
      <% # --- ИСПРАВЛЕНИЕ: Передаем правильную переменную @wall_comment, которую создали в контроллере --- %>
      <%= render 'comments/form', comment: @wall_comment %>
    </div>

    <% # Список комментариев %>
    <ul id="comments-list" style="list-style: none; padding: 0; margin: 0;">
      <% # Рендерим только сохраненные записи, чтобы избежать ошибки nil в created_at %>
      <% # --- ИСПРАВЛЕНИЕ: Используем пагинированную переменную @wall_comments вместо всех записей подряд --- %>
      <%= render @wall_comments.select(&:persisted?) %>
    </ul>

    <% # --- НОВЫЙ БЛОК: КНОПКИ ПАГИНАЦИИ ДЛЯ СТЕНЫ --- %>
    <% if @pagy_comments.pages > 1 %>
      <div style="margin-top: 20px; text-align: center;">
        <%== pagy_nav(@pagy_comments) %>
      </div>
    <% end %>
    <% # -------------------------------------------------- %>

  </div>
</div>