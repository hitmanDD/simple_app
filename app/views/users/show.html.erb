<% provide(:title, @user.name) %>
<div class="row">
  <!-- Левая колонка: Информация о пользователе и формы -->
  <aside class="col-md-4">
    <section class="user_info">
      <%# --- БЛОК АВАТАРКИ --- %>
      <%# Выносим картинку в отдельный контейнер над именем, чтобы текст не "наползал" %>
      <div class="profile-avatar-container" style="margin-bottom: 15px;">
        <%# Используем наш хелпер: покажет черный квадрат (150px) или Gravatar %>
        <%= image_tag @user.avatar_display(150), alt: @user.name, class: "user-avatar-large" %>
      </div>
      
      <h1><%= @user.name %></h1>
      <p><strong>Email:</strong> <%= @user.email %></p>

      <%# --- МОЙ КОММЕНТАРИЙ: НОВЫЙ БЛОК СТАТИСТИКИ --- %>
      <%# Оборачиваем в карточку, чтобы визуально выделить активность пользователя %>
      <div class="stats-panel mb-4 p-3 border rounded bg-light" style="font-size: 0.9em;">
        <p class="mb-2"><strong>Статус:</strong> 
          <span class="status-square <%= @user.online? ? 'online' : 'offline' %>"></span>
          <%= @user.online? ? 'В сети' : 'Оффлайн' %>
        </p>
        
        <p class="mb-2"><strong>На сайте с:</strong><br>
          <span class="text-muted"><%= time_ago_in_words(@user.created_at) %> назад</span>
        </p>

        <p class="mb-0"><strong>Активность:</strong><br>
          <span class="text-muted"><%= @user.last_seen_info %></span>
        </p>
      </div>
      <%# ---------------------------------------------- %>

      <%# Ссылка на редактирование профиля (только для владельца) %>
      <%# Это и есть наша "кнопка" для перехода к загрузчику %>
      <% if @user == current_user %>
        <div style="margin-bottom: 20px;">
          <%= link_to "Изменить фото / Настройки", edit_user_path(@user), class: "btn btn-sm btn-outline-secondary" %>
        </div>
      <% end %>

      <%= render 'follow_form' if logged_in? %>
    </section>

    <!-- Блок заметок и статистики (виден ТОЛЬКО владельцу профиля) -->
    <% if @user == current_user %>
      <section class="note_form" style="margin-top: 20px;">
        <h3 style="font-size: 1.1em;">🔒 Личные заметки</h3>
        <%= render 'shared/note_form' %>
      </section>
      
      <section class="stats" style="margin-top: 20px;">
        <%= render 'shared/stats' %>
      </section>
    <% end %>
  </aside>

  <!-- Правая колонка: Ленты контента -->
  <div class="col-md-8">
    
    <!-- Блок микросообщений (Глава 13) -->
    <% if @user.microposts.any? %>
      <h3>Микросообщения (<%= @user.microposts.count %>)</h3>
      <ol class="microposts">
        <%= render @microposts %>
      </ol>
      <%= will_paginate @microposts %>
    <% end %>

    <!-- БЛОК СТЕНЫ ПРОФИЛЯ (Кастомная фича) -->
    <hr>
    <section class="wall">
      <h3>Стена профиля (<%= @user.wall_comments.count %>)</h3>

      <%# Форма добавления записи %>
      <% if logged_in? %>
        <div class="wall_form" style="margin-bottom: 20px;">
          <%= form_with(model: [@user, Comment.new], local: true) do |f| %>
            <div class="field">
              <%= f.text_area :body, placeholder: "Напишите что-нибудь на стене...", class: "form-control" %>
            </div>
            <%= f.submit "Опубликовать", class: "btn btn-primary", style: "margin-top: 10px;" %>
          <% end %>
        </div>
      <% end %>

      <%# Вывод записей со стены %>
      <ul class="comments" style="list-style: none; padding-left: 0;">
        <% @user.wall_comments.each do |comment| %>
          <li style="border-bottom: 1px solid #eee; padding: 10px 0;">
            <strong><%= link_to comment.author.name, comment.author %>:</strong>
            <span class="content"><%= comment.body %></span>
            <div class="timestamp" style="font-size: 0.8em; color: #777;">
              <%= time_ago_in_words(comment.created_at) %> назад
              <% if current_user == comment.author || current_user == @user %>

              | <%= button_to "удалить", user_comment_path(@user, comment), 
                method: :delete, 
                data: { confirm: "Уверены?" },
                class: "btn-delete-link" %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    </section>

    <!-- Блок твоих заметок (ВИДЕН ТОЛЬКО ВЛАДЕЛЬЦУ) -->
    <% if @user == current_user && @user.notes.any? %>
      <hr> <!-- Разделительная линия между типами контента -->
      <h3>🔒 Мои личные заметки (<%= @user.notes.count %>)</h3>
      <ol class="notes">
        <% @notes.each do |note| %>
          <li>
            <span class="content"><%= note.content %></span>
            <span class="timestamp">
              Опубликовано <%= time_ago_in_words(note.created_at) %> назад.
            </span>
          </li>
        <% end %>
      </ol>
    <% end %>
  </div>
</div>