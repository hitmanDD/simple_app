<%# Устанавливаем заголовок страницы (Following или Followers) %>
<% provide(:title, @title) %>

<div class="row">
  <aside class="col-md-4">
    <section class="user_info">
      <%# Аватар пользователя %>
      <%= gravatar_for @user %>
      <%# Ссылка на основной профиль %>
      <h1><%= @user.name %></h1>
      <span><%= link_to "view my profile", @user %></span>
      <%# Количество микросообщений %>
      <span><b>Microposts:</b> <%= @user.microposts.count %></span>
    </section>
    
    <section class="stats">
      <%# Подключаем наш блок со счетчиками статистики %>
      <%= render 'shared/stats' %>
      <%# Если есть хотя бы один пользователь в списке, показываем их аватарки миниатюрами %>
      <% if @users.any? %>
        <div class="user_avatars">
          <% @users.each do |user| %>
            <%= link_to gravatar_for(user, size: 30), user %>
          <% end %>
        </div>
      <% end %>
    </section>
  </aside>

  <div class="col-md-8">
    <%# Заголовок списка (Following или Followers) %>
    <h3><%= @title %></h3>
    <%# Если список не пуст, выводим пользователей %>
    <% if @users.any? %>
      <ul class="users follow">
        <%# Рендерим каждого пользователя из коллекции @users через партиал _user.html.erb %>
        <%= render @users %>
      </ul>
      <%# Добавляем пагинацию, чтобы страница не была бесконечной %>
      <%= will_paginate %>
    <% end %>
  </div>